{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NotchLingo Deck v1",
  "type": "object",
  "description": "Content only. Card IDs must be globally unique. Runtime validation additionally checks unique IDs and matching, balanced **term** example markers.",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "track",
    "cards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "track": {
      "enum": [
        "everyday",
        "techWork"
      ]
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "term",
          "partOfSpeech",
          "cefr",
          "definition",
          "turkishMeaning",
          "examples",
          "ipaUS",
          "ipaUK",
          "tags"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "partOfSpeech": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "turkishMeaning": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "ipaUS": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "ipaUK": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cefr": {
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "C1"
            ]
          },
          "examples": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "\\*\\*[^*]+\\*\\*"
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}
